+  bool bytes_encoder_config(rmt_bytes_encoder_config_t* config) const {
+    // The IDF bytes encoder handles the common one-symbol-per-bit case
+    // without the generic encoder's per-pattern sequence bookkeeping.
+    if (chunk_size() != 1 || length(START_OFFSET_INDEX) != 0 ||
+        length(BETWEEN_OFFSET_INDEX) != 0 || length(END_OFFSET_INDEX) != 0 ||
+        length(CHUNKS_OFFSET_INDEX) != sizeof(rmt_symbol_word_t) ||
+        length(CHUNKS_OFFSET_INDEX + 2) != sizeof(rmt_symbol_word_t)) {
+      return false;
+    }
+    // Serialized patterns need not be word aligned.
+    memcpy(&config->bit0, sequence(CHUNKS_OFFSET_INDEX), sizeof(config->bit0));
+    memcpy(&config->bit1, sequence(CHUNKS_OFFSET_INDEX + 2), sizeof(config->bit1));
+    config->flags.msb_first = msb();
+    return true;
+  }
 
